{
  "name": "papercut",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @papercut/video studio",
    "render:proto": "pnpm --filter @papercut/video render:proto",
    "stills:proto": "pnpm --filter @papercut/video stills:proto",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "kit:manifest": "tsx packages/kit/scripts/manifest.ts",
    "kit:gallery": "pnpm kit:manifest && pnpm --filter @papercut/video stills:gallery",
    "test:visual": "pnpm --filter @papercut/video test:visual",
    "render:proto:landscape": "pnpm --filter @papercut/video render:proto:landscape",
    "pc": "node --import tsx apps/cli/src/index.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@fontsource/im-fell-english": "5.3.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.0",
    "prettier": "^3.9.10",
    "tsx": "4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.4"
  }
}
